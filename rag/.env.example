OPENAI_API_KEY=
# Model dostępny na Twoim koncie, obsługujący Responses i Structured Outputs.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Opcjonalnie: inny model do porównania; domyślnie taki sam jak OPENAI_MODEL.
# OPENAI_COMPARISON_MODEL=gpt-4.1-mini
DATABASE_URL=postgresql://rops:change-me@localhost:5432/rops
# Tylko jeśli uruchamiasz bazę z compose.yaml. Ustaw własne hasło
# i to samo hasło w DATABASE_URL (znaki specjalne w URL zakoduj).
POSTGRES_PASSWORD=change-me

# Adresy frontendu (origin bez ścieżki), rozdzielone przecinkami.
# Pusta wartość wyłącza CORS. Restart API po zmianie.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Ta sama baza PostgreSQL co aplikacja EF Core; domyślne nazwy PascalCase.
APP_DB_SCHEMA=public
# UUID istniejącego rekordu Statuses, początkowy status nowych pomysłów.
APP_INITIAL_STATUS_ID=
