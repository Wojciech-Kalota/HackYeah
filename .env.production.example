# Skopiuj ten plik jako .env.production i ustaw wlasne wartosci.
# Dla hasel baz i Redis uzyj dlugich znakow alfanumerycznych, bez spacji,
# dwukropkow, srednikow i znakow @ / #, aby connection stringi byly jednoznaczne.

BACKEND_DB_NAME=einicjatywa
BACKEND_DB_USER=einicjatywa
BACKEND_DB_PASSWORD=UZUPELNIJ_DLUGIE_LOSOWE_HASLO

REDIS_PASSWORD=UZUPELNIJ_INNE_DLUGIE_LOSOWE_HASLO

RAG_DB_NAME=rops
RAG_DB_USER=rops
RAG_DB_PASSWORD=UZUPELNIJ_TRZECIE_DLUGIE_LOSOWE_HASLO

OPENAI_API_KEY=UZUPELNIJ_KLUCZ_OPENAI
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
